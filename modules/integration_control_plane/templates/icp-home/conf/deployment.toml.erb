# Managed by Puppet (module: integration_control_plane). Local edits will be
# overwritten on the next Puppet run - change modules/integration_control_plane/
# manifests/params.pp or override via Hiera instead.

serverPort = <%= @server_port %>
runtimeListenerPort = <%= @runtime_listener_port %>
authBackendUrl = "<%= @auth_backend_url %>"
frontendJwtHMACSecret = "<%= @frontend_jwt_hmac_secret %>"

schedulerIntervalSeconds = <%= @scheduler_interval_seconds %>
logLevel = "<%= @log_level %>"
enableAuditLogging = <%= @enable_audit_logging %>
enableMetrics = <%= @enable_metrics %>

[icp_server.secrets]

[icp_server.storage]
<% if @db_enabled -%>
dbType = "<%= @db_type %>"
dbHost = "<%= @db_host %>"
dbPort = <%= @db_port %>
dbName = "<%= @db_name %>"
dbUser = "<%= @db_user %>"
dbPassword = "<%= @db_password %>"
<% else -%>
# Using the embedded H2 database. Set integration_control_plane::params::db_enabled
# to true and provide db_host/db_port/db_name/db_user/db_password for a
# production database (mysql, postgresql, mssql or oracle).
<% end -%>

[icp_server.storage.secrets]

[[ballerina.log.modules]]
name = "wso2/icp_server"
level = "<%= @log_level %>"
