[Unit]
Description=WSO2 Integration Control Plane
After=network.target

[Service]
ExecStart=/bin/bash <%= @install_path %>/bin/icp.sh start
ExecStop=/bin/bash <%= @install_path %>/bin/icp.sh stop
ExecReload=/bin/bash <%= @install_path %>/bin/icp.sh restart
PIDFile=<%= @install_path %>/icp.pid
User=<%= @user %>
Group=<%= @user_group %>
Type=forking
Restart=on-failure
RestartSec=5
TimeoutStartSec=180s
StartLimitInterval=60s
StartLimitBurst=3
SuccessExitStatus=0

[Install]
WantedBy=multi-user.target
