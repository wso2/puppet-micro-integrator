[Unit]
Description=WSO2 Integration Control Plane
After=network.target

[Service]
ExecStart=/bin/sh <%= @install_path %>/bin/dashboard.sh start
ExecStop=/bin/sh <%= @install_path %>/bin/dashboard.sh stop
ExecReload=/bin/sh <%= @install_path %>/bin/dashboard.sh restart
PIDFile=<%= @install_path %>/runtime.pid
User=<%= @user %>
Group=<%= @user_group %>
Type=forking
PIDFile=<%= @install_path %>/runtime.pid # Ensure PIDFile is explicitly listed for clarity, though it was implicitly correct
User=<%= @user %>
Group=<%= @user_group %>
Restart=on-failure
RestartSec=5
TimeoutStartSec=180s
StartLimitInterval=60s
StartLimitBurst=3
SuccessExitStatus=0

[Install]
WantedBy=multi-user.target
