[server]
hostname = "<%= @hostname %>"
offset = "<%= @ports_offset %>"

[user_store]
type = "read_only_ldap"

[keystore.primary]
file_name = "<%= @keystore_location %>"
password = "<%= @keystore_password %>"
alias = "<%= @keystore_alias %>"
key_password = "<%= @keystore_key_password %>"

[truststore]
file_name = "<%= @truststore_location %>"
password = "<%= @truststore_password %>"
alias = "<%= @truststore_alias %>"
algorithm = "<%= @truststore_algorithm %>"

## Connect this Micro Integrator instance to a WSO2 Integration Control Plane
## (ICP). Set micro_integrator::params::icp_enabled = true and provide
## icp_secret (the org secret issued by ICP for this environment/project/
## integration) to activate this block.
<% if @icp_enabled -%>
[icp_config]
enabled = true
icp_url = "<%= @icp_url %>"
environment = "<%= @icp_environment %>"
project = "<%= @icp_project %>"
integration = "<%= @icp_integration %>"
secret = "<%= @resolved_icp_secret %>"
heartbeat_interval = <%= @icp_heartbeat_interval %>
ssl_verify = <%= @icp_ssl_verify %>
<% else -%>
# [icp_config]
# enabled = true
# icp_url = "<%= @icp_url %>"
# environment = "<%= @icp_environment %>"
# project = "<%= @icp_project %>"
# integration = "<%= @icp_integration %>"
# secret = "<org-secret-issued-by-icp>"
# heartbeat_interval = <%= @icp_heartbeat_interval %>
# ssl_verify = <%= @icp_ssl_verify %>
<% end -%>

